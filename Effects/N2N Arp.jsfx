(mb && p_mb==0 && mx>=draw_x && mx<draw_x+trans_w && my>=draw_y && my<draw_y+20) ? ( capture_id=4999; capture_min=-3; capture_max=3; capture_ptr=ui_oct_transpose; capture_start_x=mx; capture_start_val=mem[ui_oct_transpose]; );
draw_x += trans_w + ui_gap_small;


// --- GLOBAL CONTROLS MOVED TO SIDEBAR ---
