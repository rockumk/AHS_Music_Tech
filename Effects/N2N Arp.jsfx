);

shift_dn = (mouse_cap & 8); ctrl_dn = (mouse_cap & 4);

function calc_vis_beat(t_in) local(sub_v, bar_v, p_l, playing_tab, offset_add, is_half, spd_m, buffer_beats, visual_pos) (
    sub_v = eff_sub(t_in); bar_v = eff_bars(t_in); 
    is_half = eff_half(t_in); spd_m = is_half ? 0.5 : 1.0;
    p_l = (bar_v * 4) / spd_m;
    
    l_tab = mem[ui_locked_tab];
    playing_tab = (l_tab >= 0) ? l_tab : mem[ui_play_prog_tab];
    offset_add = 0; (play_state & 1 && (t_in == playing_tab || t_in==effective_play_tab)) ? ( offset_add = playback_shift; );
    
    buffer_beats = (samplesblock / srate) * (tempo / 60);
    visual_pos = beat_position - buffer_beats;
    
    play_state & 1 ? fmod_pos(visual_pos + offset_add + (p_l * 1000), p_l) * spd_m : 0;
);
lhs_width = 180; 
btn_height = 18; grid_height = slider11; ROW_HEIGHT = grid_height; 
function draw_text(x,y,s,r,g,b) ( gfx_set(r,g,b,1); gfx_x=x; gfx_y=y; gfx_drawstr(s); );
function rect(x,y,w,h,r,g,b,a) ( gfx_set(r,g,b,a); gfx_rect(x,y,w,h); );
function draw_power_button(x,y) (
    gfx_setfont(1,os_font,fontsize,'b');
    rect(x,y,51,26,mem[ui_power_off]?0.75:0.22,0.2,0.2,1);
    draw_text(x+5,y+6,"OFF",1,1,1);
    gfx_set(0.9,0.9,0.9,1);
    gfx_arc(x+39,y+13,7,0.6,5.68,1);
    gfx_line(x+39,y+3,x+39,y+12,1);
);
function centered_btn(x,y,w,h,txt) local(tw,th) (
    gfx_setfont(1,os_font,fontsize,'b'); rect(x,y,w,h,0.3,0.3,0.3,1);
    gfx_measurestr(txt,tw,th); draw_text(x+(w-tw)/2,y+2,txt,1,1,1);
    (mb && p_mb==0 && mx>=x && mx<x+w && my>=y && my<y+h);
);
function btn(x,y,w,h,txt) ( rect(x,y,w,h, 0.3,0.3,0.3,1); draw_text(x+5,y+2,txt,1,1,1); (mb && p_mb == 0 && mx>=x && mx<x+w && my>=y && my<y+h); );

// Saved visual-only delay in milliseconds. Never used by the MIDI engine.
function visual_sync_phase(phase,total,source) local(rate,steps_per_sec) (
    rate=eff_half(source)?0.5:1;
    steps_per_sec=tempo/60*rate*eff_sub(source)/4;
    fmod_pos(phase-slider18*.001*steps_per_sec,total);
);
function help_sync_button(x,y,w,label) local(tw,th,hover) (
    hover=mx>=x && mx<x+w && my>=y && my<y+24;
    rect(x,y,w,24,hover?.4:.29,hover?.4:.29,hover?.4:.29,1);
    gfx_measurestr(label,tw,th);draw_text(x+(w-tw)/2,y+(24-th)/2,label,1,1,1);
    help_click && hover;
);
function draw_visual_sync(x,y) local(delta,old) (
    gfx_setfont(1,os_font,fontsize,'b');
    draw_text(x,y,"VISUAL SYNC (ms)",.8,.9,.9);
    old=slider18;delta=shift_dn?1:10;
    help_sync_button(x,y+22,48,"-") ? slider18=max(-500,slider18-delta);
    rect(x+53,y+22,100,24,.12,.12,.12,1);
    sprintf(#visual_sync_text,"%+d ms",slider18);
    gfx_measurestr(#visual_sync_text,vs_tw,vs_th);
    draw_text(x+53+(100-vs_tw)/2,y+22+(24-vs_th)/2,#visual_sync_text,1,1,1);
    help_sync_button(x+158,y+22,48,"+") ? slider18=min(500,slider18+delta);
    help_sync_button(x+216,y+22,64,"RESET") ? slider18=0;
    slider18!=old ? sliderchange(slider18);
    draw_text(x,y+52,"+ delays the display; - advances it. Shift-click for 1 ms.",.8,.8,.8);
);

// Display-only mix controls and guarded requests to the running N2N hub.
function mix_request(cmd,payload) local(addr,now) (
    now=time_precise();
    abs(now-gmem[8320000])<2 && my_slot>=1 && my_slot<=512 && gmem[reg_base+my_slot]==my_key ? (
        addr=8320004+(my_slot-1)*4;
        gmem[addr]=my_key;
        gmem[addr+2]=now;
        gmem[addr+3]=payload;
        gmem[addr+1]=cmd;
        1;
    ) : 0;
);
function section_play_request(tab,preroll) (
    !mix_request(4,tab*3+preroll) ? (
        section_error_tab=tab;
        section_error_until=time_precise()+0.45;
    );
);
function mix_hub_button(x,y,w,label,cmd) local(hov,online,tw,th) (
    online=abs(time_precise()-gmem[8320000])<2;
    hov=mx>=x && mx<x+w && my>=y && my<y+20;
    rect(x,y,w,20,hov&&online?.33:.18,hov&&online?.33:.18,hov&&online?.33:.18,1);
    gfx_measurestr(label,tw,th);
    draw_text(x+(w-tw)/2,y+(20-th)/2,label,online?.9:.4,online?.9:.4,online?.9:.4);
    online && hov && mb && !p_mb && capture_id==0 && !chan_popup_active && !color_popup_active ? mix_request(cmd,0);
);
function mix_display(x,y,w,kind) local(p,cx,cy,i,a,v,px,hov,mx0,mw) (
    hov=mx>=x && mx<x+w && my>=y && my<y+20;
    rect(x,y,w,20,hov?.25:.16,hov?.25:.16,hov?.25:.16,1);
    hov && !chan_popup_active && !color_popup_active ? (
        mix_hover=1;
        mb && !p_mb && capture_id==0 ? mix_request(3,0);
    );
    kind==0 ? (
    // Prominence: 0 unset, 1 mute, 2/3 down, 4 mid, 5/6 up, 8 star, 9 transition.
    p=floor(slider15+.5); cx=x+w/2; cy=y+10;
    gfx_set(.86,.86,.86,1);
    p==0 ? gfx_line(cx-4,cy,cx+4,cy) :
    p==1 ? (gfx_circle(cx,cy,6,0,1);gfx_line(cx-4,cy+4,cx+4,cy-4);) :
    p==4 ? gfx_circle(cx,cy,3,1,1) :
    p==8 ? (
        gfx_set(1,.84,.30,1);
        i=0;loop(5,a=-$pi/2+i*2*$pi/5;gfx_line(cx+7*cos(a),cy+7*sin(a),cx+7*cos(a+4*$pi/5),cy+7*sin(a+4*$pi/5),1);i+=1;);
    ) :
    p==9 ? (gfx_line(cx-7,cy+5,cx+7,cy-5);gfx_line(cx+7,cy-5,cx+2,cy-5);gfx_line(cx+7,cy-5,cx+7,cy);) :
    (
        i=0; loop(p==2||p==6?2:1,
            a=cy+(i-(p==2||p==6?.5:0))*6;
            p<4 ? (gfx_line(cx-5,a-3,cx,a+2);gfx_line(cx,a+2,cx+5,a-3);) :
                  (gfx_line(cx-5,a+3,cx,a-2);gfx_line(cx,a-2,cx+5,a+3););
            i+=1;
        );
    );
    ) : (
        // Keep the label and the bipolar meter side by side.
        mx0=x+31; mw=max(8,w-36); cx=mx0+mw/2;
        kind==1 ? (
            v=max(-100,min(100,slider17));px=cx+v*mw*.005;
            v>=0 ? rect(cx,y+6,px-cx,8,.48,.76,.42,1) : rect(px,y+6,cx-px,8,.78,.50,.32,1);
            gfx_set(.7,.7,.7,1);gfx_line(cx,y+4,cx,y+16);
            draw_text(x+3,y+3,"INT",.8,.8,.8);
        ) : (
            px=cx+max(-100,min(100,slider16))*mw*.005;
            gfx_set(.45,.45,.45,1);gfx_line(mx0,y+10,mx0+mw,y+10);gfx_line(cx,y+5,cx,y+15);
            rect(px-2,y+6,4,8,.85,.85,.85,1);
            draw_text(x+3,y+3,"PAN",.8,.8,.8);
        );
    );
);


function draw_chan_popup(px, py, row_idx, is_input) 
local(bw, bh, i, r, c, bx, by, bit, is_set, current_mask, base_ptr) 
(
    
    bw = 30; bh = 20; rect(px, py, bw*4 + 4, bh*4 + 4 + 22, 0.1, 0.1, 0.1, 1); rect(px+1, py+1, bw*4+2, bh*4+2+22, 0.2, 0.2, 0.2, 1);
    
    is_input ? (
       row_idx == -1 ? current_mask = input_filter_mask : current_mask = mem[row_in_chan_base + row_idx];
    ) : (
       row_idx == -1 ? current_mask = global_out_mask : current_mask = mem[row_chan_base + row_idx];
    );
    
    (row_idx >= 0) ? (
        rect(px+2, py+2, bw*4, 18, 0.3, 0.3, 0.3, 1);
        current_mask == -1 ? ( gfx_set(0,1,1,1); ) : ( gfx_set(0.7,0.7,0.7,1); );
        gfx_x = px+10; gfx_y = py+4; gfx_drawstr("Use Global");
        (mb && p_mb == 0 && mx>=px+2 && mx<px+2+bw*4 && my>=py+2 && my<py+20) ? (
            is_input ? mem[row_in_chan_base + row_idx] = -1 : mem[row_chan_base + row_idx] = -1;
        );
        py += 22;
    );
    
    current_mask == -1 ? current_mask = 0; 
    
    i=0; loop(16, c = i % 4; r = floor(i/4); bx = px + 2 + c*bw; by = py + 2 + r*bh; bit = 1 << i; is_set = (current_mask & bit); is_set ? rect(bx, by, bw-1, bh-1, 0.2, 0.8, 0.4, 1) : rect(bx, by, bw-1, bh-1, 0.3, 0.3, 0.3, 1); sprintf(#cs, "%d", i+1); draw_text(bx+8, by+5, #cs, 1,1,1); 
    
    (mb && p_mb == 0 && mx>=bx && mx<bx+bw && my>=by && my<by+bh) ? ( 
        (row_idx >= 0 && (is_input ? mem[row_in_chan_base+row_idx] : mem[row_chan_base+row_idx]) == -1) ? ( current_mask = 0; );
        
        current_mask = current_mask ~ bit; 
        
        is_input ? (
            row_idx == -1 ? ( current_mask = current_mask & 32767; input_filter_mask = current_mask; ) : ( mem[row_in_chan_base + row_idx] = current_mask; );
        ) : (
            row_idx == -1 ? ( current_mask = current_mask & 32767; global_out_mask = current_mask; ) : ( mem[row_chan_base + row_idx] = current_mask; );
        );
    ); 
    i+=1; 
);
    (mb && p_mb == 0 && !(mx>=px && mx<px+bw*4+4 && my>=py-22 && my<py+bh*4+4) && popup_cooldown == 0) ? chan_popup_active = 0;
);

mx=mouse_x; my=mouse_y; mb=mouse_cap&1; rmb=mouse_cap&2; p_mb=l_mb; l_mb=mb; p_rmb=l_rmb; l_rmb=rmb; gfx_clear = 0.05; p_mx=l_mx; l_mx=mx; 
// Help is modal: preserve raw click edge but suppress all underlying controls.
help_click=help_active && mb && !p_mb;
!mb && !rmb ? help_block_until_release=0;
help_active || help_block_until_release ? (
    mb=0;rmb=0;mouse_wheel=0;mouse_hwheel=0;capture_id=0;
);
