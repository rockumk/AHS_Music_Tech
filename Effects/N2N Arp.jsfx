    idx == 23 ? strcpy(out, "1<") :
    idx == 24 ? strcpy(out, "1=") :
    idx == 25 ? strcpy(out, "1>") :
    idx == 26 ? strcpy(out, "Default") :
    idx == 27 ? strcpy(out, "User 1") :
    idx == 28 ? strcpy(out, "User 2") :
    idx == 29 ? strcpy(out, "User 3") :
    idx == 30 ? strcpy(out, "4") :
    idx == 31 ? strcpy(out, "5") :
    idx == 32 ? strcpy(out, "Verse 2") :
    idx == 33 ? strcpy(out, "B") :
    idx == 34 ? strcpy(out, "C") :
    idx == 35 ? strcpy(out, "D") :
    idx == 36 ? strcpy(out, "Pre 2") :
    idx == 37 ? strcpy(out, "B") :
    idx == 38 ? strcpy(out, "C") :
    idx == 39 ? strcpy(out, "D") :
    idx == 40 ? strcpy(out, "Chorus 2") :
    idx == 41 ? strcpy(out, "B") :
    idx == 42 ? strcpy(out, "C") :
    idx == 43 ? strcpy(out, "D") :
    idx == 44 ? strcpy(out, "Solo") :
    idx == 45 ? strcpy(out, "B") :
    idx == 46 ? strcpy(out, "C") :
    idx == 47 ? strcpy(out, "D") :
    idx == 48 ? strcpy(out, "H3") :
    idx == 49 ? strcpy(out, "H4") :
