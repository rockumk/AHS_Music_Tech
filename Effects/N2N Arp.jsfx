draw_x += gllev_w + ui_gap_small;


// Global CH IN Button
glchan_w = 151;
mask = input_filter_mask;
rect(draw_x, draw_y, glchan_w, 20, 0.2,0.2,0.2,1); 
draw_text(draw_x+5, draw_y+3, "GLOBAL CHAN IN:", 0.7,0.7,0.7); 
set_cnt=0; bit_i=0; loop(16, (mask & (1<<bit_i)) ? set_cnt+=1; bit_i+=1;); 
set_cnt == 0 ? strcpy(#cs, "None") : set_cnt == 16 ? strcpy(#cs, "All") : sprintf(#cs, "%d Set", set_cnt); 
draw_text(draw_x+108, draw_y+3, #cs, 1,1,1);
// Fixed: Mouse hitbox mapped to draw_x and draw_y instead of sl_x and sl_y
(mb && p_mb==0 && mx>=draw_x && mx<draw_x+glchan_w && my>=draw_y && my<draw_y+20 && popup_cooldown == 0) ? ( 
    chan_popup_active = 1; chan_popup_row = -1; chan_popup_is_input = 1; chan_popup_x = mx; chan_popup_y = my; popup_cooldown = 10; 
