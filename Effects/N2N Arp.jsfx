        gx_s=0; loop(st_v, cx = grid_x + gx_s*cw; idx = r_idx*vel_stride_row + gx_s; owner = mem[ownership_map+gx_s]; is_head = (owner == idx); is_tail = (owner != -1 && !is_head);
