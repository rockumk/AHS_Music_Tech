mix_speed_x=tab_right_x-stretch_w;
mix_stretch_x=mix_speed_x-2*ttabw;
mix_hub_x=tab_right_x+5;
mix_level_x=mix_speed_x-29; 

!mb && !rmb ? ( 
    capture_id = 0; 
