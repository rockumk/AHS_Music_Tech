// MOUSE HANDLING - JSFX SLIDERS (9000-9999)


// MOUSE HANDLING - JSFX SLIDERS (9000-9999)
(mb && capture_id >= 9000 && capture_id < 10000) ? ( 
    drag_accum_gen += (mx - p_mx); 
    drag_sens = 5.0; 
    abs(drag_accum_gen) >= drag_sens ? (
        inc = floor(drag_accum_gen / drag_sens); 
        drag_accum_gen -= (inc * drag_sens); 
