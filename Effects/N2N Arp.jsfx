draw_text(949,draw_y+4,"GRV:",.6,.6,.6);
gr_max=mem[LOCAL_GROOVE_DB+32];
gr_max==0?gfx_set(.3,.3,.3,1):gr_max>1?gfx_set(1,0,0,1):gfx_set(0,1,0,1);
gfx_circle(987,draw_y+10,4.5,1);
draw_text(draw_x,draw_y+4,"SCALE:",.6,.6,.6);
note_x=draw_x+55;
scale_tonic==-1 ? draw_text(note_x,draw_y+4,"---",1,.2,.2) : (
    // Measure at normal size; only reduce spacing/font for unusually dense scales.
    scale_room=mix_level_x-note_x-5;
    scale_font=fontsize;
    loop(2,
        gfx_setfont(1,os_font,scale_font,'b');
        scale_note_count=0;scale_text_width=0;i=0;
        loop(13,
            pc=(scale_tonic+i)%12;
            mem[scale_state_base+pc] ? (
            t_n=pc;
            t_n==0?strcpy(#t,"C"):t_n==1?strcpy(#t,"C#"):t_n==2?strcpy(#t,"D"):t_n==3?strcpy(#t,"D#"):t_n==4?strcpy(#t,"E"):t_n==5?strcpy(#t,"F"):t_n==6?strcpy(#t,"F#"):t_n==7?strcpy(#t,"G"):t_n==8?strcpy(#t,"G#"):t_n==9?strcpy(#t,"A"):t_n==10?strcpy(#t,"A#"):strcpy(#t,"B");
                gfx_measurestr(#t,tw,th);scale_text_width+=tw;scale_note_count+=1;
            );i+=1;
        );
        scale_text_width>scale_room-max(0,scale_note_count-1) && scale_font==fontsize ? (
            scale_font=max(8,floor(fontsize*(scale_room-max(0,scale_note_count-1))/max(1,scale_text_width)));
        );
    );
    scale_gap=max(0,min(8,(scale_room-scale_text_width)/max(1,scale_note_count-1)));
    i=0;loop(13,
        pc=(scale_tonic+i)%12;
        mem[scale_state_base+pc] ? (
            t_n=pc;
            t_n==0?strcpy(#t,"C"):t_n==1?strcpy(#t,"C#"):t_n==2?strcpy(#t,"D"):t_n==3?strcpy(#t,"D#"):t_n==4?strcpy(#t,"E"):t_n==5?strcpy(#t,"F"):t_n==6?strcpy(#t,"F#"):t_n==7?strcpy(#t,"G"):t_n==8?strcpy(#t,"G#"):t_n==9?strcpy(#t,"A"):t_n==10?strcpy(#t,"A#"):strcpy(#t,"B");
            pc==scale_tonic?gfx_set(1,.2,.2,1):gfx_set(.8,.8,.8,1);
            gfx_x=note_x;gfx_y=draw_y+4;gfx_drawstr(#t);
            gfx_measurestr(#t,tw,th);note_x+=tw+scale_gap;
        );i+=1;
    );
);
gfx_setfont(1,os_font,fontsize,'b');
mix_hover=0;
my_slot>=1 && my_slot<=512 ? (
    section_reply_addr=8320004+(my_slot-1)*4;
    gmem[section_reply_addr]==my_key && gmem[section_reply_addr+1]==0 && gmem[section_reply_addr+3]<0 ? (
        section_error_tab=floor(-gmem[section_reply_addr+3]/3);
        section_error_until=time_precise()+0.45;
        gmem[section_reply_addr+3]=0;
    );
);

draw_x  = drawhold_x;
draw_y  = drawhold_y;



pat_y = row1_y + 26; pat_w = gfx_w / 64; 
ui_tab_h = 38; // Manual Tab Height




row2_y = UI_TOP_Y + 24;

// --- FOLLOW BUTTON (Drum Arranger Style) ---











// =========================================================
// ROWS 2, 3, 4: CONSOLIDATED TABS AND LEFT INFO COLUMN
// =========================================================
// Read the same stable audio snapshot for the entire frame.
gfx_seq_before=vis_seq;
gfx_seq_before%2==0 ? (
    gfx_tmp_requested=vis_audio_requested; gfx_tmp_source=vis_audio_source;
    gfx_tmp_step=vis_audio_step; gfx_tmp_phase=vis_audio_phase;
    gfx_tmp_total=vis_audio_total; gfx_tmp_running=vis_audio_running;
    gfx_seq_before==vis_seq ? (
        gfx_vis_requested=gfx_tmp_requested; gfx_vis_source=gfx_tmp_source;
        gfx_vis_step=gfx_tmp_step; gfx_vis_phase=gfx_tmp_phase;
        gfx_vis_total=gfx_tmp_total; gfx_vis_running=gfx_tmp_running;
    );
);
// Shift only the frame-local visual clock, not the raw snapshot or MIDI clock.
gfx_draw_phase=gfx_vis_phase;gfx_draw_step=gfx_vis_step;
gfx_vis_running && gfx_vis_total>0 && gfx_vis_source>0 ? (
    gfx_draw_phase=visual_sync_phase(gfx_vis_phase,gfx_vis_total,gfx_vis_source);
    gfx_draw_step=floor(gfx_draw_phase);
);
// Hub pattern navigation: keyed by registration token; never writes a cue or lock.
hub_edit_addr=8300000+(my_slot-1)*2;
hub_edit_cmd=gmem[hub_edit_addr+1];
hub_edit_cmd>0 && gmem[hub_edit_addr]==my_key && gmem[reg_base+my_slot]==my_key ? (
    hub_edit_tab=floor(hub_edit_cmd)-1;
    hub_edit_tab>=1 && hub_edit_tab<TOTAL_TABS ? (
        mem[ui_edit_tab]=hub_edit_tab;
        hub_browse=1; hub_browse_source=gfx_vis_source; hub_browse_request=gfx_vis_requested;
    );
    gmem[hub_edit_addr+1]=0;
);
// In Follow mode select the requested song section, not its inherited source.
// Keep an active mouse gesture on its original tab until the user releases.
mem[ui_locked_tab]==-1 && !mem[ui_power_off] ? (
    gfx_next_tab=gfx_vis_requested;
    hub_browse && (gfx_vis_source!=hub_browse_source || gfx_vis_requested!=hub_browse_request) ? hub_browse=0;
    !hub_browse && gfx_next_tab>=1 && gfx_next_tab<TOTAL_TABS ? (
        ((play_state&1) || gfx_next_tab!=gfx_follow_target) && !mb && !rmb && !chan_popup_active && !color_popup_active ? (
            mem[ui_edit_tab]=gfx_next_tab;
            gfx_follow_target=gfx_next_tab;
        );
    );
) : gfx_follow_target=-1;

draw_y = ROW2_Y; // Advance Y to Tab Area
FOLLOW_LBL_X=5; FOLLOW_BOX_X=65; FOLLOW_BOX_W=20; FOLLOW_BOX_H=16;

// Display inheritance even when parked.
arrow_req=mem[ui_locked_tab]>=0?mem[ui_locked_tab]:mem[ui_play_prog_tab];
arrow_eff=(form_count>0 && !midi_form_override && mem[ui_locked_tab]==-1)?resolve_pattern(arrow_req):resolve_requested(arrow_req);
arrow_show=!mem[ui_power_off] && arrow_req>=0 && arrow_req<TOTAL_TABS && arrow_eff>0 && arrow_eff<TOTAL_TABS && arrow_req!=arrow_eff;
arrow_req_x=-1; arrow_eff_x=-1;

current_tab_row = 1;
loop(3,
    // --- LEFT COLUMN (REC Cues & Follow MIDI) ---
    current_tab_row == 1 ? (
        rec_cues_active=0;
        power_x=10; power_y=draw_y;
        draw_power_button(power_x,power_y);
        (mb && !p_mb && mx>=power_x && mx<power_x+51 && my>=power_y && my<power_y+26) ? (
            mem[ui_power_off]=!mem[ui_power_off]; needs_tab_update=1;
        );
    ) : current_tab_row==2 ? (
        // Use the standard GUI font, not the default graphics font.
        gfx_setfont(1,os_font,fontsize,'b');
        // draw_text(FOLLOW_LBL_X+21,draw_y+17,"FOLLOW",0.8,0.8,0.8);
        draw_text(FOLLOW_LBL_X+10,draw_y+36,"FOLLOW SONG STRUCTURE",0.8,0.8,0.8);
    ) : (
        is_follow=mem[ui_locked_tab]==-1 && !midi_form_override;
        follow_lock_y=draw_y-3;
        // Outline the label and lock as a single control.
        follow_group_x=10; follow_group_y=draw_y-30;
        follow_group_w=tab_start_x-follow_group_x-5; follow_group_h=30+26;
        gfx_set(0.45,0.45,0.45,1);
        gfx_rect(follow_group_x,follow_group_y,follow_group_w,follow_group_h,0);
        // Original shackle/body geometry: open shackle while following.
        gfx_set(0.9,0.9,0.9,1);
        gfx_circle(FOLLOW_BOX_X+25,follow_lock_y-2,7,0);
        gfx_circle(FOLLOW_BOX_X+25,follow_lock_y-12,6.5,0);
        gfx_circle(FOLLOW_BOX_X+25,follow_lock_y-12,6,0);
        gfx_circle(FOLLOW_BOX_X+25,follow_lock_y-12,5.5,0);
        gfx_circle(FOLLOW_BOX_X+25,follow_lock_y-13,5,0);
        is_follow ? rect(FOLLOW_BOX_X+25,follow_lock_y-15,10,11,0,0,0,1);
        rect(FOLLOW_BOX_X+15,follow_lock_y-10,FOLLOW_BOX_W+1,FOLLOW_BOX_H,0.5,0.5,0.5,1);
        is_follow ? (
            rect(FOLLOW_BOX_X+15,follow_lock_y-10,FOLLOW_BOX_W+1,FOLLOW_BOX_H,0.18,0.9,0.9,1);
            gfx_set(0,0,0,1);
            gfx_triangle(FOLLOW_BOX_X+22,follow_lock_y-7,FOLLOW_BOX_X+22,follow_lock_y+3,FOLLOW_BOX_X+30,follow_lock_y-2);
        );
        gfx_setfont(1,os_font,fontsize,'b');
        (mb && !p_mb && mx>=follow_group_x && mx<follow_group_x+follow_group_w && my>=follow_group_y && my<follow_group_y+follow_group_h) ? (
            mem[ui_locked_tab]=-1; gmem[GM_BASE+1]=-1; mem[ui_follow_mode]=1; gfx_follow_target=-1; hub_browse=0; cue_release_requested=1; needs_tab_update=1;
        );
    );

    mem[ui_tab_view_mode]==1 && !eligible_song_tab(mem[ui_edit_tab]) && mem[ui_edit_tab]!=26 && mem[ui_edit_tab]!=77 ? mem[ui_edit_tab]=26;

    // --- DRAW THE TABS FOR THIS ROW (SECTIONS MODE ONLY) ---
    (mem[ui_tab_view_mode] == 1) ? (
        draw_x = tab_start_x; 
        gui_i=0;
        loop(current_tab_row==3?22:19,
            gui_t=visible_tab_at(current_tab_row,gui_i);
            my_row = mem[tab_ui_row_base + gui_t];
            (my_row == current_tab_row) ? (
                item_w = mem[tab_w_base + gui_t]; 
                arrow_show && gui_t == arrow_req ? (
                    arrow_req_x = draw_x; arrow_req_y = draw_y;
                    arrow_req_w = item_w - 5; arrow_req_h = 26;
                );
                arrow_show && gui_t == arrow_eff ? (
                    arrow_eff_x = draw_x; arrow_eff_y = draw_y;
                    arrow_eff_w = item_w - 5; arrow_eff_h = 26;
                );
                is_ed = (gui_t == mem[ui_edit_tab]);
                t_r = mem[tab_col_r + gui_t]; t_g = mem[tab_col_g + gui_t]; t_b = mem[tab_col_b + gui_t];
                
                is_ed ? ( rect(draw_x, draw_y, item_w-5, 26, 1, 1, 1, 1); rect(draw_x+1, draw_y+1, item_w-7, 24, t_r, t_g, t_b, 1); ) 
                      : ( rect(draw_x, draw_y, item_w-5, 26, t_r*0.4, t_g*0.4, t_b*0.4, 1); );
                      
                get_t_name(gui_t, #tn); 
                gfx_setfont(1, os_font, fontsize, 'b'); 
                is_ed ? draw_text(draw_x+3, draw_y+5, #tn, 0, 0, 0) : draw_text(draw_x+3, draw_y+4, #tn, 1, 1, 1);
                
                // Match Drum Arranger: transport gestures take precedence over browse/lock.
                tab_hover=mx>=draw_x && mx<draw_x+item_w-5 && my>=draw_y && my<draw_y+26;
                !chan_popup_active && !color_popup_active && capture_id==0 && tab_hover ? (
                    mb && !p_mb && shift_dn ? (
                        last_tab_clk=0;
                        section_play_request(gui_t,1);
                    ) : rmb && !p_rmb ? (
                        gfx_x=mx; gfx_y=my;
                        section_play_menu=gfx_showmenu("-2|-1|Play|Stop|Pause");
                        section_play_menu>0 ? (
                            last_tab_clk=0;
                            section_play_menu<=3 ? section_play_request(gui_t,3-section_play_menu) :
                            section_play_menu==4 ? mix_request(5,0) :
                            section_play_menu==5 ? mix_request(6,0);
                        );
                    );
                );
                (!shift_dn && mb && p_mb == 0 && mx>=draw_x && mx<draw_x+item_w-24 && my>=draw_y && my<draw_y+26) ? ( 
                                rec_cues_active ? (
                                    send_tab_trigger(gui_t);
                                    mem[tab_flash_base + gui_t] = 10;
                                ) : (
                        (time_precise() - last_tab_clk < 0.3 && last_tab_idx == gui_t) ? (
                            mem[ui_locked_tab] = gui_t; mem[ui_edit_tab] = gui_t;   
                            gmem[GM_BASE+1] = mem[ui_locked_tab]; last_tab_clk = 0; 
                        ) : (
                            mem[ui_edit_tab] = gui_t;
                            mem[ui_locked_tab] == 0 ? mem[ui_locked_tab] = -1; 
                            last_tab_clk = time_precise(); last_tab_idx = gui_t;
                        );
                    );
                );

                // Current MIDI-cued section: yellow lower half (13px of the 26px button).
                // Draw before the black lock and the white populated-section dog-ear.
                (arrow_req==gui_t && !mem[ui_power_off]) ? rect(draw_x-1, draw_y+18, item_w-4, 7, 1.0, 1.0, 0.2, 1);
                gfx_set(0.0, 0.0, 0.0, 1); gfx_circle(draw_x+item_w-17, ly=draw_y+8, 6, 0); gfx_circle(draw_x+item_w-17, ly=draw_y+8, 5, 0); gfx_circle(draw_x+item_w-17, ly=draw_y+8, 4, 0); 
                lx=draw_x+item_w-25; ly=draw_y+9; lw=17; lh=14; rect(lx,ly,lw,lh, 0,0,0,1); 

                (!shift_dn && mb && p_mb == 0 && mx>=lx-3 && mx<lx+lw+3 && my>=ly-2 && my<ly+lh+2) ? ( 
                    rec_cues_active == 0 ? (
                        mem[ui_locked_tab]=(mem[ui_locked_tab]==gui_t?-1:gui_t); 
                        gmem[GM_BASE+1]=mem[ui_locked_tab]; mem[ui_play_offset] = 0; playback_shift = 0; 
                    );
                );

                // Right-click is handled by the section transport menu.
                
                // Locked: cyan lock body with a small play-shaped marker.
                // Unlocked: the existing grey body and hoop remain neutral.
                mem[ui_locked_tab] == gui_t ? (
                    rect(lx+1, ly+2, lw-2, lh-3, 0.3, .9, .7, 1);
                    gfx_set(0.08, 0.15, 0.15, 1);
                    gfx_triangle(lx+6, ly+4, lx+6, ly+11, lx+12, ly+7.5);
                );
                (mem[tab_mute_base+gui_t]&2) ? (gfx_set(1,0.45,0.45,1); gfx_line(draw_x+5,draw_y+21,draw_x+14,draw_y+12,1););
                mem[LOC_TAB_POPULATED + gui_t] ? (
                    // White content bracket: top and left only.
                    gfx_set(1, 1, 1, 1);
                    gfx_rect(draw_x-1, draw_y-2, 4, 20);
                    gfx_rect(draw_x-1, draw_y-2, 14, 4);
                );
                
                f_amt = mem[tab_flash_base + gui_t];
                f_amt > 0 ? ( rect(draw_x, draw_y, item_w-5, 26, 1, 1, 1, f_amt/10); mem[tab_flash_base + gui_t] -= 1; );
                gui_t==section_error_tab && time_precise()<section_error_until ? (
                    rect(draw_x,draw_y,item_w-5,26,1,.05,.05,min(.85,(section_error_until-time_precise())*4));
                );
                
                draw_x += item_w; 
            );
            gui_i += 1;
        );
    );
    draw_y += 30; 
    current_tab_row += 1;
);

// --- DRAW SLOTS MODE ---
(mem[ui_tab_view_mode] == 0) ? (
    pat_x_offset = tab_start_x; 
    pat_y = ROW2_Y; 
    pat_w = (tab_right_x-pat_x_offset)/64; 
    ui_tab_h = 38;

    i=0; loop(128, 
        row_idx = floor(i/64); col_idx = i % 64; 
        px = pat_x_offset + (col_idx * pat_w); 
        py = pat_y + (row_idx * (ui_tab_h + 10));
        // Capture visible slot geometry without changing the UI interactions.
        arrow_show && i == arrow_req ? (
            arrow_req_x = px + 1; arrow_req_y = py;
            arrow_req_w = pat_w; arrow_req_h = ui_tab_h + 3;
        );
        arrow_show && i == arrow_eff ? (
            arrow_eff_x = px + 1; arrow_eff_y = py;
            arrow_eff_w = pat_w; arrow_eff_h = ui_tab_h + 3;
        );
        
        is_curr = (mem[ui_edit_tab] == i); is_play = (arrow_req==i && !mem[ui_power_off]); is_lock = (mem[ui_locked_tab] == i);
        is_curr ? (r=.0; g=.25; b=.45;) : (r=0.35; g=0.35; b=0.35;); 
        rect(px+1, py, pat_w, ui_tab_h+3, r, g, b, 1);
        
        (is_shift_now = (mouse_cap & 8);) ? (
            (i == 0) ? ( br=1.0; bg=0.8; bb=0.2; ) : (
                c_grp = floor((i) / 8) % 8;
                c_grp == 0 ? (br=0.7; bg=0.7; bb=0.7;) : c_grp == 1 ? (br=0.2; bg=0.8; bb=0.8;) : c_grp == 2 ? (br=0.3; bg=0.5; bb=0.9;) : c_grp == 3 ? (br=0.7; bg=0.3; bb=0.9;) : c_grp == 4 ? (br=0.9; bg=0.3; bb=0.3;) : c_grp == 5 ? (br=0.9; bg=0.6; bb=0.2;) : c_grp == 6 ? (br=0.3; bg=0.8; bb=0.4;) : (br=0.7; bg=0.7; bb=0.7;);
            );
            rect(px+1, py-4, pat_w, 4, br, bg, bb, 1);
        );

        is_lock ? (lr=.2; lg=.9; lb=.2;) : (lr=COL_H_R*1.5; lg=COL_H_G*1.5; lb=COL_H_B*1.5;); 
        rect(px+2, py+20, pat_w-4, 15, lr, lg, lb, 1);
        // Song position is shown by a full-width yellow U-shaped underline below.
        
        gfx_setfont(1, os_font, fontsize-2, 'b'); 
        (i == 0) ? ( draw_text(px+4, py+8, "0", 1, 1, 1); ) : (
            (i) >= 100 ? ( sprintf(#lbl, "%d", floor(((i)%100)/10)); draw_text(px+1, py+1, #lbl, 0.9,0.9,0.9); sprintf(#lbl, "%d", (i)%10); draw_text(px+1, py+8, #lbl, 0.9,0.9,0.9); ) : (i) >= 10 ? ( sprintf(#lbl, "%d", floor((i)/10)); draw_text(px+1, py+1, #lbl, 0.9,0.9,0.9); sprintf(#lbl, "%d", (i)%10); draw_text(px+1, py+8, #lbl, 0.9,0.9,0.9); ) : ( sprintf(#lbl, "%d", i); draw_text(px+1, py+8, #lbl, 0.9,0.9,0.9); );
        );

        (mem[tab_mute_base+i]&2) ? (gfx_set(1,0.45,0.45,1); gfx_line(px+3,py+15,px+pat_w-3,py+5,1););
        mem[LOC_TAB_POPULATED + i] ? ( gfx_set(1, 1, 1, 1); gfx_rect(px+2, py+17, pat_w-4, 3); );
        
        f_amt = mem[tab_flash_base + i];
        f_amt > 0 ? ( rect(px, py, pat_w, ui_tab_h+3, 1, 1, 1, f_amt/10); mem[tab_flash_base + i] -= 1; );
        // Slots are too narrow for a second title accent; retain only the yellow base.
        is_play ? rect(px+1, py+ui_tab_h-2, pat_w, 4, 1.0, 1.0, 0.2, 1);

        (mb && p_mb==0 && mx>=px && mx<px+pat_w && capture_id == 0) ? (
                    (my >= py && my < py + ui_tab_h) ? (
                        rec_cues_active ? (
                            send_tab_trigger(i);
                            mem[tab_flash_base + i] = 10;
                        ) : (
                    (my > py + 20) ? (
                        mem[ui_locked_tab] = i; gmem[GM_BASE+1] = i; mem[ui_follow_mode] = 0;
                    ) : (
                        (time_precise() - last_tab_clk < 0.3 && last_tab_idx == i) ? ( 
                            mem[ui_locked_tab] = i; gmem[GM_BASE+1] = i; mem[ui_follow_mode] = 0; last_tab_clk = 0; mem[ui_edit_tab] = i; 
                        ) : (
                            mem[ui_edit_tab] = i; last_tab_clk = time_precise(); last_tab_idx = i; 
                        ); 
                    ); 
                );
                capture_id = -2; 
            );
        ); 
        i+=1;
    );
    gfx_setfont(1, os_font, fontsize, 'b'); 
);

// VISUAL ONLY: overlay one green arrow from the active MIDI-cued tab
// to the effective playback pattern. Do not recalculate the fallback.
arrow_show && arrow_req_x >= 0 && arrow_eff_x >= 0 ? (
    arrow_req_cx = arrow_req_x + arrow_req_w * 0.5;
    arrow_req_cy = arrow_req_y + arrow_req_h * 0.5;
    arrow_eff_cx = arrow_eff_x + arrow_eff_w * 0.5;
    arrow_eff_cy = arrow_eff_y + arrow_eff_h * 0.5;

    abs(arrow_req_cy - arrow_eff_cy) < 1 ? (
        // Same row: connect the nearest vertical edges at their centers.
        arrow_y1 = arrow_req_cy; arrow_y2 = arrow_eff_cy;
        arrow_req_cx < arrow_eff_cx ? (
            arrow_x1 = arrow_req_x + arrow_req_w;
            arrow_x2 = arrow_eff_x;
        ) : (
            arrow_x1 = arrow_req_x;
            arrow_x2 = arrow_eff_x + arrow_eff_w;
        );
    ) : abs(arrow_req_cx - arrow_eff_cx) < 12 ? (
        // Same column: connect horizontal edges at their centers.
        arrow_x1 = arrow_req_cx; arrow_x2 = arrow_eff_cx;
        arrow_req_cy < arrow_eff_cy ? (
            arrow_y1 = arrow_req_y + arrow_req_h;
            arrow_y2 = arrow_eff_y;
        ) : (
            arrow_y1 = arrow_req_y;
            arrow_y2 = arrow_eff_y + arrow_eff_h;
        );
    ) : (
        // Diagonal: compare all 16 corner pairs and choose the closest.
        arrow_best_d2 = 1000000000; // Large initial squared-distance value
        arrow_i = 0;
        loop(4,
            arrow_ax = arrow_req_x + ((arrow_i & 1) ? arrow_req_w : 0);
            arrow_ay = arrow_req_y + ((arrow_i & 2) ? arrow_req_h : 0);
            arrow_j = 0;
            loop(4,
                arrow_bx = arrow_eff_x + ((arrow_j & 1) ? arrow_eff_w : 0);
                arrow_by = arrow_eff_y + ((arrow_j & 2) ? arrow_eff_h : 0);
                arrow_dx = arrow_bx - arrow_ax;
                arrow_dy = arrow_by - arrow_ay;
                arrow_d2 = arrow_dx*arrow_dx + arrow_dy*arrow_dy;
                arrow_d2 < arrow_best_d2 ? (
                    arrow_best_d2 = arrow_d2;
                    arrow_x1 = arrow_ax; arrow_y1 = arrow_ay;
                    arrow_x2 = arrow_bx; arrow_y2 = arrow_by;
                );
                arrow_j += 1;
            );
            arrow_i += 1;
        );
    );

    arrow_dx = arrow_x2 - arrow_x1;
    arrow_dy = arrow_y2 - arrow_y1;
    arrow_len = sqrt(arrow_dx*arrow_dx + arrow_dy*arrow_dy);
    // Adjacent tabs leave only a 4-5px gap, compressing the arrowhead.
    // For short connections, overlap each tab slightly to keep the head legible.
    // Drawing coordinates only; source selection remains untouched.
    arrow_len > 1 && arrow_len < 24 ? (
        arrow_extend = (24 - arrow_len) * 0.5 + 4;
        arrow_x1 -= (arrow_dx / arrow_len) * arrow_extend;
        arrow_y1 -= (arrow_dy / arrow_len) * arrow_extend;
        arrow_x2 += (arrow_dx / arrow_len) * arrow_extend;
        arrow_y2 += (arrow_dy / arrow_len) * arrow_extend;
        arrow_dx = arrow_x2 - arrow_x1;
        arrow_dy = arrow_y2 - arrow_y1;
        arrow_len = sqrt(arrow_dx*arrow_dx + arrow_dy*arrow_dy);
    );
    arrow_len > 1 ? (
        arrow_ux = arrow_dx / arrow_len;
        arrow_uy = arrow_dy / arrow_len;
        arrow_nx = -arrow_uy;
        arrow_ny = arrow_ux;
        arrow_head = min(11, arrow_len * 0.35);
        arrow_half = 1.5; // Three-pixel shaft.
        arrow_base_x = arrow_x2 - arrow_ux * arrow_head;
        arrow_base_y = arrow_y2 - arrow_uy * arrow_head;
        gfx_set(0, 1, 0, 1);
        gfx_triangle(
            arrow_x1 + arrow_nx*arrow_half, arrow_y1 + arrow_ny*arrow_half,
            arrow_x1 - arrow_nx*arrow_half, arrow_y1 - arrow_ny*arrow_half,
            arrow_base_x - arrow_nx*arrow_half, arrow_base_y - arrow_ny*arrow_half
        );
        gfx_triangle(
            arrow_x1 + arrow_nx*arrow_half, arrow_y1 + arrow_ny*arrow_half,
            arrow_base_x - arrow_nx*arrow_half, arrow_base_y - arrow_ny*arrow_half,
            arrow_base_x + arrow_nx*arrow_half, arrow_base_y + arrow_ny*arrow_half
        );
        gfx_triangle(
            arrow_x2, arrow_y2,
            arrow_base_x + arrow_nx*5, arrow_base_y + arrow_ny*5,
            arrow_base_x - arrow_nx*5, arrow_base_y - arrow_ny*5
        );
    );
);

