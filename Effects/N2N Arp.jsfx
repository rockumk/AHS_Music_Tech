    mem[base_ptr+4] = n2;
    mem[base_ptr+3] = n3;
    mem[base_ptr+2] = n3;
    mem[base_ptr+1] = n4;
    mem[base_ptr+0] = n5;
    mem[base_ptr+8] = dn1;
);

