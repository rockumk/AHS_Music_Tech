desc:N2N Arp
version: 12.4.0-dev.15
author: Rock Kennedy
about:
  # N2N Arp v12.4.0-dev.15
  - Shared song form, revised sections, independent OFF, and pattern library.
provides:
  [main] .

options:gmem=N2N_Ecosystem_RSKennedy

slider1:110<1,127,1>-Default Row Velocity
slider2:0<0,25,1>-Global Humanize
slider3:2<0,4,1{8,12,16,24,32}>-Global Subdiv
slider4:4<1,4,1>-Global Bars
slider5:1<1,512,1>-Instance ID
slider6:0<0,100,1>-Global Swing
slider7:36<1,128,1>-Visible Rows
slider8:0<0,128,1>-View Scroll
slider9:0<0,1,1{P, M}>-Swing Source (Default=P)
slider10:0<0,1,1{N2N Script,Live MIDI}>-Chord Source
slider11:12<10,30,1>-Grid Row Height
slider12:20<1,127,1>-Global Note Len
slider13:100<0,100,1>-Global Row Level
slider14:0<0,2,1{Chords,Split (Chords and Bass),Bass}>-Input Mode
// Display-only mirrors written by N2N Mix; never used in MIDI generation.
slider15:0<0,9,1>-N2N Mix Prominence
slider16:0<-100,100,0.01>-N2N Mix Position
slider17:0<-100,100,0.01>-N2N Mix Intensity
slider18:0<-500,500,1>-Visual Sync (ms)

@init
scale_dirty = 0;
last_input_mode = -1;
thisversion = "v12.4.0-dev.15";


fontsize = 12;       // use 12 for PC and 11 for Mac
os_font = "Helvetica";
titlefontsize = 20;  // use 24 for PC and 20 for Mac


// =========================================================
// VISUALS
// =========================================================
COL_L_R = 0.557; COL_L_G = 0.110; COL_L_B = 0.086; 
COL_M_R = 0.698; COL_M_G = 0.431; COL_M_B = 0.059; 
COL_H_R = 0.141; COL_H_G = 0.365; COL_H_B = 0.443;

LOCK_R = 0.3; LOCK_G = 0.6; LOCK_B = 0.7; 

LANE_BG_DIM = 0.6; 
LABEL_BRIGHTNESS = 4.0;
grid_height = slider11; 

ext_noinit == 0 ? (
    // Moved defaults to ui_init_done block below to ensure variables exist
    need_view_center = 1;   
);


ext_noinit = 1.0;
ext_noundo = 1;

// =========================================================
// REGISTRATION
// =========================================================
reg_base = 8000000;

my_key == 0 ? ( 
    seed = floor(time_precise()*100000)+floor(rand(100000)); 
    loop(seed%10, rand(100)); 
    my_key = floor(rand(9000000))+1; 
);

reg_done = 0; curr_id = slider5;
while (reg_done == 0 && curr_id <= 512) (
    slot_val = gmem[reg_base + curr_id];
    (slot_val == 0 || slot_val == my_key) ? ( gmem[reg_base + curr_id] = my_key; slider5 = curr_id; reg_done = 1; ) : ( curr_id += 1; );
);
slider5 > 512 ? slider5 = 512;
my_slot=slider5;

// =========================================================
// MEMORY ALLOCATION
// =========================================================
mem_pos = 10000; 

ui_base = mem_pos; mem_pos += 32;
ui_edit_tab      = ui_base + 0;
ui_selected_row  = ui_base + 1;
ui_locked_tab    = ui_base + 2;
ui_play_prog_tab = ui_base + 3;
ui_play_offset   = ui_base + 4;
ui_anchor_valid  = ui_base + 5;
ui_last_step     = ui_base + 6;
ui_oct_transpose = ui_base + 7; 
ui_follow_mode   = ui_base + 8;
ui_vel_edit_all  = ui_base + 9;
ui_init_done     = ui_base + 10;
ui_power_off     = ui_base + 12;

mem[ui_oct_transpose] < -3 || mem[ui_oct_transpose] > 3 ? mem[ui_oct_transpose] = 0;



mem[ui_locked_tab] < -1 ? mem[ui_locked_tab] = -1;

input_state_base = mem_pos; mem_pos += 128; 
input_chan_base  = mem_pos; mem_pos += 128; 
scale_state_base = mem_pos; mem_pos += 12; 
scale_tonic      = -1;
scale_note_vels  = mem_pos; mem_pos += 128; 

chord_count = 0;
current_chord_root = -1; 
chord_notes = mem_pos; mem_pos += 5; 
chord_vels  = mem_pos; mem_pos += 5; 
chord_intervals = mem_pos; mem_pos += 5; 
chord_is_oos = mem_pos; mem_pos += 5; 

// Pitch Role Database
pitch_role_db = mem_pos; mem_pos += 12;

// DEBUG MEMORY
debug_slot_pitch = mem_pos; mem_pos += 8; 
debug_slot_vel   = mem_pos; mem_pos += 8;
debug_slot_lbl   = mem_pos; mem_pos += 8; 

LANE_COUNT = 9;
lane_pitch_a  = mem_pos; mem_pos += LANE_COUNT;
lane_pitch_b  = mem_pos; mem_pos += LANE_COUNT;
lane_pitch_lh = mem_pos; mem_pos += LANE_COUNT;

// Piano / Dual Mode constants
PIANO_BASS_VEL = 90;   // Change if your coded bass velocity is different

RH_ZERO_DROP = 6;      // Original RH set 0 (near incoming range)
LH_ZERO_DROP = 10;      // Old RH -4 becomes LH Bass set 0

bass_coded_note = -1;

ui_tab_view_mode = ui_base + 11; // 0 = Slots, 1 = Sections

MAX_ROWS = 128; MAX_STEPS = 128; MAX_TABS = 128; TOTAL_TABS = 128;

tab_ui_row_base = mem_pos; mem_pos += TOTAL_TABS;
tab_w_base      = mem_pos; mem_pos += TOTAL_TABS;
tab_col_r       = mem_pos; mem_pos += TOTAL_TABS;
tab_col_g       = mem_pos; mem_pos += TOTAL_TABS;
tab_col_b       = mem_pos; mem_pos += TOTAL_TABS;


tab_mute_base   = mem_pos; mem_pos += TOTAL_TABS;
tab_flash_base  = mem_pos; mem_pos += TOTAL_TABS;
rec_cues_active = 0;
GMEM_REC_FLAG_ADDR = 5000100;
midi_trigger_queued = -1;

// Initialize mutes to 0
i_mt = 0; loop(TOTAL_TABS, mem[tab_mute_base + i_mt] = 0; i_mt += 1;);


row_mute_base  = mem_pos; mem_pos += MAX_ROWS;
row_solo_base  = mem_pos; mem_pos += MAX_ROWS;
row_note_base  = mem_pos; mem_pos += MAX_ROWS; 
row_chan_base  = mem_pos; mem_pos += MAX_ROWS; 
row_level_base = mem_pos; mem_pos += MAX_ROWS;
row_human_base = mem_pos; mem_pos += MAX_ROWS;
row_len_base   = mem_pos; mem_pos += MAX_ROWS;
row_name_idx   = mem_pos; mem_pos += MAX_ROWS;
row_color_base = mem_pos; mem_pos += MAX_ROWS;
row_in_chan_base = mem_pos; mem_pos += MAX_ROWS; 

bars_ov_base   = mem_pos; mem_pos += MAX_TABS;
subdiv_ov_base = mem_pos; mem_pos += MAX_TABS;
hum_ov_base    = mem_pos; mem_pos += MAX_TABS;
swing_ov_base  = mem_pos; mem_pos += MAX_TABS;
half_speed_ov_base = mem_pos; mem_pos += MAX_TABS; 

vel_stride_tab = MAX_ROWS * MAX_STEPS;
vel_stride_row = MAX_STEPS;

// DATA BUFFERS
mem_pos = 1000000; 
vel_base      = mem_pos; mem_pos += (TOTAL_TABS * MAX_ROWS * MAX_STEPS);
grid_base     = mem_pos; mem_pos += (TOTAL_TABS * MAX_ROWS * MAX_STEPS);
step_len_base = mem_pos; mem_pos += (TOTAL_TABS * MAX_ROWS * MAX_STEPS);

// EXTENSIONS
EXT_COUNT = TOTAL_TABS - MAX_TABS;
ext_bars_ov_base = mem_pos; mem_pos += EXT_COUNT; 
ext_subdiv_ov_base = mem_pos; mem_pos += EXT_COUNT; 
ext_hum_ov_base = mem_pos; mem_pos += EXT_COUNT; 
ext_swing_ov_base = mem_pos; mem_pos += EXT_COUNT;
ext_half_speed_ov_base = mem_pos; mem_pos += EXT_COUNT;

ext_vel_base = vel_base + MAX_TABS * vel_stride_tab;
ext_grid_base = grid_base + MAX_TABS * vel_stride_tab;
ext_step_len_base = step_len_base + MAX_TABS * vel_stride_tab;

copy_row_v_buf = mem_pos; mem_pos += MAX_STEPS;
copy_row_g_buf = mem_pos; mem_pos += MAX_STEPS;
copy_row_l_buf = mem_pos; mem_pos += MAX_STEPS;
copy_tab_v_buf = mem_pos; mem_pos += MAX_ROWS * MAX_STEPS;
copy_tab_g_buf = mem_pos; mem_pos += MAX_ROWS * MAX_STEPS;
copy_tab_l_buf = mem_pos; mem_pos += MAX_ROWS * MAX_STEPS;

bar_copy_base = mem_pos; mem_pos += (MAX_ROWS * 32 * 3); 

ownership_map = mem_pos; mem_pos += MAX_STEPS;
sort_tmp_n = mem_pos; mem_pos += 130;
sort_tmp_v = mem_pos; mem_pos += 130;
kill_buf_size = 128 * 17;
kill_buf = mem_pos; mem_pos += kill_buf_size;
kill_chan = mem_pos; mem_pos += kill_buf_size; 

pending_pattern = -1; sync_reset_req = 0; sync_offset_beats = 0;
paint_state = 0; last_paint_idx = -1;
len_drag_start_idx = -1; len_drag_base_col = 0; len_drag_max = 0;
popup_cooldown = 0; help_active = 0; drag_accum_gen = 0; 
drag_lock_row = -1; drag_mode = 0; last_drag_idx = -1;

playback_shift = 0; last_play_tab = -1; last_play_offset = -1; pc_triggered = 0;
// Separate visual snapshot from audio lookahead and the editor's selected tab.
vis_seq=0; vis_audio_requested=-1; vis_audio_source=0; vis_audio_step=-1; vis_audio_phase=0; vis_audio_total=0; vis_audio_running=0;
gfx_follow_target=-1; gfx_vis_source=0; gfx_vis_requested=-1; gfx_vis_step=-1; gfx_vis_phase=0; gfx_vis_total=0; gfx_vis_running=0;

input_filter_mask = 32767; 
global_out_mask = 1;       

// N2N CONSTANTS & BUFFER
GMEM_CTX_OFFSET = 3000000; 
GMEM_SCALE_OFFSET = 3100000;
GMEM_GROOVE_OFFSET = 5000000; 
LOCAL_SCALE_DB = mem_pos; mem_pos += 10000;
LOCAL_GROOVE_DB = mem_pos; mem_pos += 33; 

// --- NEW FEATURES: CUE, INFO & INVENTORY ---
LOC_TAB_POPULATED = mem_pos; mem_pos += TOTAL_TABS;
GMEM_INFO_BASE = 8200000;
GMEM_INV_BASE = 7500000; 
GMEM_GLOBAL_ADDR = 7100200;
GMEM_TYPE_BASE = 7100300;
GMEM_INST_BASE = 7100500;
GMEM_TYPE_REPORT = 8100000;
MY_TYPE_ID = 2; // Arp ID (Drums are 1)

// Cue State Machine
cue_armed = 0;           
cue_target_tab = -1;     
cue_source_type = -1;    
gmem_source_addr = -1;
cue_clear_pending = 0;
cue_clear_addr = -1;
midi_cue_tab = -1;
midi_cue_source = -1;
last_bar_checked = -1;
last_maint_time = 0; 

parent_tonic = 0;
scale_entry_count = 0;
current_mask = 2741; 
prev_mask = -1; 
prev_tonic = -1;

// Initial Setup
i=0; loop(MAX_ROWS, 
    mem[row_chan_base+i] == 0 ? mem[row_chan_base+i] = -1; 
    mem[row_level_base+i] == 0 ? mem[row_level_base+i] = -1; 
    mem[row_len_base+i] == 0 ? mem[row_len_base+i] = -1; 
    mem[row_human_base+i] == 0 ? mem[row_human_base+i] = -1;
    mem[row_in_chan_base+i] == 0 ? mem[row_in_chan_base+i] = -1;
    i+=1;
);

fontsize = 13; // Set baseline font size

function t(id, r_ui, name, w, cr, cg, cb) (
  mem[tab_ui_row_base + id] = r_ui;
  mem[tab_w_base + id] = w;
  mem[tab_col_r + id] = cr;
  mem[tab_col_g + id] = cg;
  mem[tab_col_b + id] = cb;
);

//ttabw = 45; hw = ttabw; sectw = ttabw * 2; ftabs = 60;
ttabw = 39; hw = ttabw; sectw = ttabw * 2; ftabs = 51; hww = ttabw * 1.2;
stretch_w = 87; special_tab_w = stretch_w + 5;

// Visible tab layout. Keep all 80 internal pattern addresses for old projects.
t(26,1,"Default",5*ttabw,0.7,0.7,0.9);
t(77,2,"Count-In",5*ttabw,0.7,0.7,0.7);
t(1,3,"Intro A",sectw,0.2,1.0,1.0);
t(2,3,"B",ttabw,0.2,1.0,1.0);
t(3,3,"C",ttabw,0.2,1.0,1.0);
t(4,3,"D",ttabw,0.2,1.0,1.0);
t(5,1,"Verse 1",sectw,0.5,0.7,1.0);
t(6,1,"B",ttabw,0.5,0.7,1.0);
t(7,1,"C",ttabw,0.5,0.7,1.0);
t(8,1,"D",ttabw,0.5,0.7,1.0);
t(9,1,"Pre 1",sectw,0.5,0.7,1.0);
t(10,1,"B",ttabw,0.5,0.7,1.0);
t(11,1,"C",ttabw,0.5,0.7,1.0);
t(12,1,"D",ttabw,0.5,0.7,1.0);
t(13,1,"Chorus 1",sectw,1.0,0.4,0.4);
t(14,1,"B",ttabw,1.0,0.4,0.4);
t(15,1,"C",ttabw,1.0,0.4,0.4);
t(16,1,"D",ttabw,1.0,0.4,0.4);
t(17,1,"Bridge",sectw,1.0,0.9,0.2);
t(18,1,"B",ttabw,1.0,0.9,0.2);
t(19,1,"C",ttabw,1.0,0.9,0.2);
t(20,1,"D",ttabw,1.0,0.9,0.2);
t(75,1,"Drop",special_tab_w,0.55,0.55,0.55);
t(27,1,"User 1",2*ttabw,0.55,0.55,0.55);
t(32,2,"Verse 2",sectw,0.5,0.7,1.0);
t(33,2,"B",ttabw,0.5,0.7,1.0);
t(34,2,"C",ttabw,0.5,0.7,1.0);
t(35,2,"D",ttabw,0.5,0.7,1.0);
t(36,2,"Pre 2",sectw,0.5,0.7,1.0);
t(37,2,"B",ttabw,0.5,0.7,1.0);
t(38,2,"C",ttabw,0.5,0.7,1.0);
t(39,2,"D",ttabw,0.5,0.7,1.0);
t(40,2,"Chorus 2",sectw,1.0,0.4,0.4);
t(41,2,"B",ttabw,1.0,0.4,0.4);
t(42,2,"C",ttabw,1.0,0.4,0.4);
t(43,2,"D",ttabw,1.0,0.4,0.4);
t(44,2,"Solo",sectw,0.2,0.8,0.3);
t(45,2,"B",ttabw,0.2,0.8,0.3);
t(46,2,"C",ttabw,0.2,0.8,0.3);
t(47,2,"D",ttabw,0.2,0.8,0.3);
t(76,2,"Breakdown",special_tab_w,0.55,0.55,0.55);
t(28,2,"User 2",2*ttabw,0.55,0.55,0.55);
t(59,3,"Verse 3",sectw,0.5,0.7,1.0);
t(60,3,"B",ttabw,0.5,0.7,1.0);
t(61,3,"C",ttabw,0.5,0.7,1.0);
t(62,3,"D",ttabw,0.5,0.7,1.0);
t(63,3,"Pre 3",sectw,0.5,0.7,1.0);
t(64,3,"B",ttabw,0.5,0.7,1.0);
t(65,3,"C",ttabw,0.5,0.7,1.0);
t(66,3,"D",ttabw,0.5,0.7,1.0);
t(67,3,"Chorus 3",sectw,1.0,0.4,0.4);
t(68,3,"B",ttabw,1.0,0.4,0.4);
t(69,3,"C",ttabw,1.0,0.4,0.4);
t(70,3,"D",ttabw,1.0,0.4,0.4);
t(71,3,"Outro",sectw,0.5,0.8,0.7);
t(72,3,"B",ttabw,0.5,0.8,0.7);
t(73,3,"C",ttabw,0.5,0.8,0.7);
t(74,3,"D",ttabw,0.5,0.8,0.7);
t(78,3,"Fadeout",special_tab_w,0.55,0.55,0.55);
t(29,3,"User 3",2*ttabw,0.55,0.55,0.55);

// Display order differs from storage order; retain original IDs.
function visible_tab_at(r,i) local(n,k,g,b) (
    n = r == 3 ? 4 : 1;
    i < n ? (r == 1 ? 26 : r == 2 ? 77 : 1+i) :
    i < n+16 ? (
        k=i-n; g=floor(k/4); 
        b=r==1?(g==0?5:g==1?9:g==2?13:17):
          r==2?(g==0?32:g==1?36:g==2?40:44):
               (g==0?59:g==1?63:g==2?67:71);
        b+k%4;
    ) : i==n+16 ? 26+r : (r==1?75:r==2?76:78);
);
function eligible_song_tab(t) (
    (t>=1 && t<=20)||(t>=32 && t<=47)||(t>=59 && t<=74)||
    (t>=27 && t<=29)||t==75||t==76||t==78;
);
function default_tab() local(i,found) (
    found=0;
    mem[LOC_TAB_POPULATED+26] ? found=26 : (
        i=1; loop(TOTAL_TABS-1,
            found==0 && eligible_song_tab(i) && mem[LOC_TAB_POPULATED+i] && !(mem[tab_mute_base+i]&2) ? found=i;
            i+=1;
        );
    );
    found;
);

function get_t_name(idx, out) (
    idx == 0 ?  strcpy(out, "Off") :
    idx == 1 ?  strcpy(out, "Intro A") :
    idx == 2 ?  strcpy(out, "B") :
    idx == 3 ?  strcpy(out, "C") :
    idx == 4 ?  strcpy(out, "D") :
    idx == 5 ?  strcpy(out, "Verse 1") :
    idx == 6 ?  strcpy(out, "B") :
    idx == 7 ?  strcpy(out, "C") :
    idx == 8 ?  strcpy(out, "D") :
    idx == 9 ?  strcpy(out, "Pre 1") :
    idx == 10 ? strcpy(out, "B") :
    idx == 11 ? strcpy(out, "C") :
    idx == 12 ? strcpy(out, "D") :
    idx == 13 ? strcpy(out, "Chorus 1") :
    idx == 14 ? strcpy(out, "B") :
    idx == 15 ? strcpy(out, "C") :
    idx == 16 ? strcpy(out, "D") :
    idx == 17 ? strcpy(out, "Bridge") :
    idx == 18 ? strcpy(out, "B") :
    idx == 19 ? strcpy(out, "C") :
    idx == 20 ? strcpy(out, "D") :
    idx == 21 ? strcpy(out, "H1") :
