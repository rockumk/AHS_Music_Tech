function assign_lanes()
local(i, k, swapped, n0, n1, n2, n3, n4, n5, dn1, root,
      cnt, p_low, p_mid, p_high, gap_count, fill_buf)
(
    i=0; loop(LANE_COUNT, mem[lane_pitch_a+i] = -1; mem[lane_pitch_b+i] = -1; i+=1; );


(chord_count == 1) ? (
  root = mem[chord_notes+0];

  n1 = next_scale_up(root);
  n2 = next_scale_up(n1);
  n3 = next_scale_up(n2);
  n4 = next_scale_up(n3);
  n5 = next_scale_up(n4);

  dn1 = next_scale_dn(root);

  mem[lane_pitch_a+7] = root;
  mem[lane_pitch_a+6] = n1;
  mem[lane_pitch_a+5] = n1;
  mem[lane_pitch_a+4] = n2;
  mem[lane_pitch_a+3] = n3;
  mem[lane_pitch_a+2] = n3;
  mem[lane_pitch_a+1] = n4;
  mem[lane_pitch_a+0] = n5;
  mem[lane_pitch_a+8] = dn1;

) : chord_count > 0 ? (
  mem[lane_pitch_a+0] = mem[chord_notes+0];
  mem[lane_pitch_a+1] = (chord_count > 1) ? mem[chord_notes+1] : -1;
  mem[lane_pitch_a+2] = (chord_count > 2) ? mem[chord_notes+2] : -1;

  cnt = (chord_count > 3) ? 3 : chord_count; 

        swapped = 1;
        while (swapped) (
            swapped = 0; k = 0;
            loop(cnt - 1,
                n0 = mem[lane_pitch_a+k]; n1 = mem[lane_pitch_a+k+1];
                (n1 != -1 && n0 > n1) ? (
                    mem[lane_pitch_a+k] = n1; mem[lane_pitch_a+k+1] = n0;
                    swapped = 1;
                ); k += 1;
            );
        );
        
        p_low  = mem[lane_pitch_a+0];
        p_mid  = (cnt > 1) ? mem[lane_pitch_a+1] : -1;
        p_high = (cnt > 2) ? mem[lane_pitch_a+2] : -1;
        
        mem[lane_pitch_a+7] = p_low;
        mem[lane_pitch_a+4] = p_mid;
        mem[lane_pitch_a+1] = p_high;
        
        mem[lane_pitch_a+0] = -1; mem[lane_pitch_a+2] = -1; mem[lane_pitch_a+1] = p_high;

        fill_buf = 50000; 

        (p_low != -1 && p_mid != -1) ? (
            gap_count = get_scale_notes_between(p_low, p_mid, fill_buf);
            gap_count == 0 ? ( mem[lane_pitch_a+6] = p_low; mem[lane_pitch_a+5] = p_mid; ) :
            gap_count == 1 ? ( mem[lane_pitch_a+6] = mem[fill_buf]; mem[lane_pitch_a+5] = mem[fill_buf]; ) :
            gap_count >= 2 ? ( mem[lane_pitch_a+6] = mem[fill_buf]; mem[lane_pitch_a+5] = mem[fill_buf + gap_count - 1]; );
        );

        (p_mid != -1 && p_high != -1) ? (
            gap_count = get_scale_notes_between(p_mid, p_high, fill_buf);
            gap_count == 0 ? ( mem[lane_pitch_a+3] = p_mid; mem[lane_pitch_a+2] = p_high; ) :
            gap_count == 1 ? ( mem[lane_pitch_a+3] = mem[fill_buf]; mem[lane_pitch_a+2] = mem[fill_buf]; ) :
            gap_count >= 2 ? ( mem[lane_pitch_a+3] = mem[fill_buf]; mem[lane_pitch_a+2] = mem[fill_buf + gap_count - 1]; );
        );

        p_high != -1 ? ( 
             gap_count = get_scale_notes_between(p_high, p_high+13, fill_buf); 
             gap_count > 0 ? ( mem[lane_pitch_a+0] = mem[fill_buf]; ) : ( mem[lane_pitch_a+0] = next_scale_up(p_high); );
        );
        p_low != -1 ? ( 
             next_dn = -1; k=1; 
             scale_tonic != -1 ? ( while(k<12 && next_dn==-1) ( mem[scale_state_base + (p_low-k+120)%12] ? next_dn=p_low-k; k+=1; ); ) : ( next_dn = p_low - 1; ); 
             mem[lane_pitch_a+8] = next_dn; 
        );
    );
);

// --- NEW INVENTORY REPORTING FUNCTIONS ---

function flush_inventory_to_gmem()
local(inst_offset, i, m0, m1, m2, m3, mask_idx, rem)
(
    // Calculate GMEM address for this instance (matches Drum Arranger logic)
    inst_offset = GMEM_INV_BASE + (floor(my_slot) - 1) * 4;
    gmem[reg_base+my_slot]==my_key ? (
    m0=0; m1=0; m2=0; m3=0;
    
    i=0; loop(TOTAL_TABS, 
        mem[LOC_TAB_POPULATED + i] ? (
            // Arp maps Tab Index directly to PC (0-127)
            mask_idx = floor(i / 32);
            rem = i % 32;
            mask_idx == 0 ? m0 |= (1 << rem) :
            mask_idx == 1 ? m1 |= (1 << rem) :
            mask_idx == 2 ? m2 |= (1 << rem) :
            mask_idx == 3 ? m3 |= (1 << rem);
        );
        i += 1;
    );
    
    // Broadcast populated status to ecosystem
    gmem[inst_offset+0] = m0;
    gmem[inst_offset+1] = m1;
    gmem[inst_offset+2] = m2;
    gmem[inst_offset+3] = m3;
    );
);

function check_tab_population(t_idx)
local(ptr, k, has_d)
(
    has_d = (mem[tab_mute_base+t_idx]&2) ? 1 : 0;
    ptr = grid_base + t_idx*vel_stride_tab;
    
    // Quick scan: if any step has velocity > 0, tab is populated
    k = 0; 
    while (k < vel_stride_tab && has_d == 0) (
        mem[ptr + k] > 0 ? has_d = 1;
        k += 1;
    );
    mem[LOC_TAB_POPULATED + t_idx] = has_d;
);

function scan_active_tab() (
    check_tab_population(mem[ui_edit_tab]);
    flush_inventory_to_gmem();
);

function scan_all_tabs() local(i) (
    i = 0; loop(TOTAL_TABS, check_tab_population(i); i+=1; );
    flush_inventory_to_gmem();
);

// =========================================================
// ANALYZE INPUT
// =========================================================
function analyze_input() local(i, cnt, n, v, j, tmp_n, tmp_v, root_pitch, diff, sort_mode, found_89, pc, n_norm) (
    
    cnt = 0; 
    i = 0; 
    
    bass_coded_note = -1;
    
    loop(128, 
        (mem[input_state_base+i] > 0) ? ( 
            vel_i = mem[input_state_base+i];
    
            // In piano mode, remember the coded bass note separately
            (slider14 == 1 && vel_i == PIANO_BASS_VEL && bass_coded_note < 0) ? (
                bass_coded_note = i;
            );
    
            mem[sort_tmp_n+cnt] = i; 
            mem[sort_tmp_v+cnt] = vel_i; 
            cnt += 1; 
        ); 
        i += 1; 
    );
        
        
    
    sort_mode = (slider10 == 0) ? 0 : 1;
    
    i = 0; 
    loop(cnt, 
        j = i + 1; 
        loop(cnt - 1 - i, 
            do_swap = 0;
            (sort_mode == 0) ? ( 
                (mem[sort_tmp_v+j] > mem[sort_tmp_v+i]) ? do_swap = 1; 
            ) : ( 
                (mem[sort_tmp_n+j] < mem[sort_tmp_n+i]) ? do_swap = 1; 
            );
            do_swap ? ( 
                tmp_n = mem[sort_tmp_n+i]; mem[sort_tmp_n+i] = mem[sort_tmp_n+j]; mem[sort_tmp_n+j] = tmp_n; 
                tmp_v = mem[sort_tmp_v+i]; mem[sort_tmp_v+i] = mem[sort_tmp_v+j]; mem[sort_tmp_v+j] = tmp_v; 
            ); 
            j += 1; 
        ); 
        i += 1; 
    );
    
      chord_count = 0; 
            i = 0; 
            loop(cnt, 
                (chord_count < 5) ? ( 
                    n = mem[sort_tmp_n+i];
                    v = mem[sort_tmp_v+i];
            
                    keep_note = 1;
            
                    // 0 = Chords, 1 = Split, 2 = Bass
                    (slider14 == 2) ? (
                        (v != PIANO_BASS_VEL) ? keep_note = 0; // Bass Mode: Destroy everything except Bass
                    ) : (
                        (v == PIANO_BASS_VEL) ? keep_note = 0; // Chords/Split Mode: Remove Bass from standard lanes
                    );
            
                    keep_note ? (
                        (chord_count == 0 || n != mem[chord_notes + chord_count - 1]) ? ( 
                            mem[chord_notes + chord_count] = n; 
                            mem[chord_vels + chord_count] = v; 
                            chord_count += 1; 
                        ); 
                    );
                ); 
                i += 1; 
            );
    
    global_oos = 0; 
    (scale_tonic != -1) ? ( 
        i = 0; 
        loop(chord_count, 
            n = mem[chord_notes+i]; 
            pc = n % 12; 
            (mem[scale_state_base + pc] == 0) ? global_oos = 1; 
            i += 1; 
        ); 
    );
    
    memset(pitch_role_db, 0, 12);
    i = 0;
    loop(8, 
        mem[debug_slot_pitch + i] = -1;
        mem[debug_slot_vel + i] = 0; 
        mem[debug_slot_lbl + i] = 0;
        i += 1;
    );

      current_chord_root = -1; 
      found_89 = 0; 
      
      i = 0; 
      loop(chord_count, 
          (mem[chord_vels+i] == 89 || mem[chord_vels+i] == 90) ? ( 
              current_chord_root = mem[chord_notes+i]; 
              found_89 = 1; 
              mem[debug_slot_pitch + 1] = current_chord_root;
              mem[debug_slot_vel + 1] = mem[chord_vels+i];
              mem[debug_slot_lbl + 1] = 1; 
          ); 
          i += 1; 
      );
      
      
      
      
      
// Fallback: if no explicit root marker, use the coded bass note as root reference (applies to all modes)
      (!found_89 && bass_coded_note >= 0) ? (
          current_chord_root = bass_coded_note;
          found_89 = 1;
          mem[debug_slot_pitch + 1] = current_chord_root;
          mem[debug_slot_vel + 1] = PIANO_BASS_VEL;
          mem[debug_slot_lbl + 1] = 1;
      );




    (found_89) ? (
        pc = current_chord_root % 12;
        mem[pitch_role_db + pc] = 1;

        i = 0; 
        loop(chord_count,
            n = mem[chord_notes+i];
            v = mem[chord_vels+i];
            
            (v != 89 && v != 90) ? (
                pc = n % 12;
                n_norm = n;
                while (n_norm < current_chord_root) ( n_norm += 12; );
                diff = n_norm - current_chord_root;
                while (diff >= 12) ( diff -= 12; ); 
                
                (v == 88) ? (
                    mem[debug_slot_pitch + 2] = n;
                    mem[debug_slot_vel + 2] = v;
                    (diff == 1) ? ( mem[pitch_role_db+pc] = 2; mem[debug_slot_lbl + 2] = 2; ) : 
                    (diff == 2) ? ( mem[pitch_role_db+pc] = 3; mem[debug_slot_lbl + 2] = 3; ); 
                ) :
                (v == 87) ? (
                    mem[debug_slot_pitch + 3] = n;
                    mem[debug_slot_vel + 3] = v;
                    (diff == 3) ? ( mem[pitch_role_db+pc] = 4; mem[debug_slot_lbl + 3] = 4; ) : 
                    (diff == 4) ? ( mem[pitch_role_db+pc] = 5; mem[debug_slot_lbl + 3] = 5; );
                ) :
                (v == 86) ? (
                    mem[debug_slot_pitch + 4] = n;
                    mem[debug_slot_vel + 4] = v;
                    (diff == 5) ? ( mem[pitch_role_db+pc] = 6; mem[debug_slot_lbl + 4] = 6; ) : 
                    (diff == 6) ? ( mem[pitch_role_db+pc] = 7; mem[debug_slot_lbl + 4] = 7; );
                ) :
                (v == 85) ? (
                    mem[debug_slot_pitch + 5] = n;
                    mem[debug_slot_vel + 5] = v;
                    (diff == 6) ? ( mem[pitch_role_db+pc] = 8; mem[debug_slot_lbl + 5] = 8; ) : 
                    (diff == 7) ? ( mem[pitch_role_db+pc] = 9; mem[debug_slot_lbl + 5] = 9; ) :
                    (diff == 8) ? ( mem[pitch_role_db+pc] = 10; mem[debug_slot_lbl + 5] = 10; );
                ) :
                (v == 84) ? (
                    mem[debug_slot_pitch + 6] = n;
                    mem[debug_slot_vel + 6] = v;
                    (diff == 8) ? ( mem[pitch_role_db+pc] = 11; mem[debug_slot_lbl + 6] = 11; ) : 
                    (diff == 9) ? ( mem[pitch_role_db+pc] = 12; mem[debug_slot_lbl + 6] = 12; );
                ) :
                (v == 83) ? (
                    mem[debug_slot_pitch + 7] = n;
                    mem[debug_slot_vel + 7] = v;
                    (diff == 9)  ? ( mem[pitch_role_db+pc] = 15; mem[debug_slot_lbl + 7] = 15; ) :
                    (diff == 10) ? ( mem[pitch_role_db+pc] = 13; mem[debug_slot_lbl + 7] = 13; ) : 
                    (diff == 11) ? ( mem[pitch_role_db+pc] = 14; mem[debug_slot_lbl + 7] = 14; );
                ) : 0;
            );
            i += 1;
        );
    );
    assign_lanes();
    
    clear_lane_set(lane_pitch_lh);
    (slider14 == 1 && bass_coded_note != -1) ? (
        assign_single_note_lanes(lane_pitch_lh, bass_coded_note);
    );
    );

function recalc_scale() local(i, max_v, best_tonic) (
    i=0; loop(12, mem[scale_state_base+i] = 0; i+=1; ); max_v = 0; best_tonic = -1;
    i=0; loop(128, v = mem[scale_note_vels+i]; v > 0 ? ( pc = i % 12; mem[scale_state_base + pc] = 1; v > max_v ? ( max_v = v; best_tonic = pc; ); ); i+=1; );
    scale_tonic = best_tonic;
);

mem[ui_init_done] == 0 ? (
    // --- FIX: SET DEFAULTS HERE ---
    
    mem[ui_follow_mode] = 1; // Follow mode displays the pattern being played.
    mem[ui_edit_tab] = 26;      // Start on Def instead of Off
    mem[ui_play_prog_tab] = 26; // Optional, but keeps things visually consistent
    
    mem[ui_locked_tab] = -1; // Default Lock: OFF
    mem[ui_tab_view_mode] = 1; // Default to Sections Mode
    // ------------------------------

    i=0; loop(TOTAL_TABS, 
        mem[subdiv_ov_base+i] = -1; 
        mem[hum_ov_base+i]    = -1; 
        mem[swing_ov_base+i]  = -1; 
        i+=1; 
    );
    mem[ui_init_done] = 1;
);

function send_tab_trigger(t_idx) local(out_n) (
    out_n = -1;

    // --- SYSTEM & USER TABS ---
    t_idx == 0  ? out_n = 24 : // Off
    t_idx == 26 ? out_n = 25 : // Def
    t_idx == 53 ? out_n = 19 : // Min
    (t_idx >= 27 && t_idx <= 31) ? out_n = 1 + (t_idx - 27) : // User 1-5
    (t_idx >= 54 && t_idx <= 58) ? out_n = 6 + (t_idx - 54) : // User 6-10

    // --- HOOKS & FILLS ---
    t_idx == 21 ? out_n = 20 : // Ptn 1 (21)
    t_idx == 22 ? out_n = 21 : // Ptn 2 (22)
    t_idx == 48 ? out_n = 22 : // Ptn 6 (48)
    t_idx == 49 ? out_n = 23 : // Ptn 7 (49)
    (t_idx >= 23 && t_idx <= 25) ? out_n = 26 + (t_idx - 23) : // Ptn 3-5
    (t_idx >= 50 && t_idx <= 52) ? out_n = 29 + (t_idx - 50) : // Ptn 8-10

    // --- SONG SECTIONS ---
    (t_idx >= 1  && t_idx <= 4)  ? out_n = 32 + (t_idx - 1)  : // Intro A-D
    (t_idx >= 5  && t_idx <= 8)  ? out_n = 36 + (t_idx - 5)  : // Verse 1 A-D
    (t_idx >= 32 && t_idx <= 35) ? out_n = 40 + (t_idx - 32) : // Verse 2 A-D
    (t_idx >= 59 && t_idx <= 62) ? out_n = 44 + (t_idx - 59) : // Verse 3 A-D
    (t_idx >= 9  && t_idx <= 12) ? out_n = 48 + (t_idx - 9)  : // Pre 1 A-D
    (t_idx >= 36 && t_idx <= 39) ? out_n = 52 + (t_idx - 36) : // Pre 2 A-D
    (t_idx >= 63 && t_idx <= 66) ? out_n = 56 + (t_idx - 63) : // Pre 3 A-D
    (t_idx >= 13 && t_idx <= 16) ? out_n = 60 + (t_idx - 13) : // Chorus 1 A-D
    (t_idx >= 40 && t_idx <= 43) ? out_n = 64 + (t_idx - 40) : // Chorus 2 A-D
    (t_idx >= 67 && t_idx <= 70) ? out_n = 68 + (t_idx - 67) : // Chorus 3 A-D
    (t_idx >= 17 && t_idx <= 20) ? out_n = 72 + (t_idx - 17) : // Bridge A-D
    (t_idx >= 44 && t_idx <= 47) ? out_n = 76 + (t_idx - 44) : // Solo A-D
    (t_idx >= 71 && t_idx <= 74) ? out_n = 80 + (t_idx - 71) : // Outro A-D
    (t_idx >= 75 && t_idx <= 79) ? out_n = 84 + (t_idx - 75) : // RSV 1-5
    0;

    (out_n != -1) ? (
        midi_trigger_queued = out_n; 
        cue_armed = 1;
        cue_target_tab = t_idx;
        
        // Don't jump the user's view while recording cues
        rec_cues_active == 0 ? ( mem[ui_edit_tab] = t_idx; );
    );
);



FORM_MAX=4096; FORM_BASE=6000000;
form_cache=mem_pos; mem_pos+=FORM_MAX*3;
form_stage=mem_pos; mem_pos+=FORM_MAX*3;
form_count=0; form_rev=-1;
function form_find(q) local(lo,hi,m,ans) (
    lo=0; hi=form_count-1; ans=-1;
    while(lo<=hi)(m=floor((lo+hi)/2); mem[form_cache+m*3]<=q ? (ans=m;lo=m+1;) : hi=m-1;);
    ans>=0 && q<mem[form_cache+ans*3+1] ? ans : -1;
);
function form_refresh() local(rev,n,i,p,tmp) (
    rev=gmem[FORM_BASE+1];
    gmem[FORM_BASE]==0x4E324631 && rev>0 && !(rev%2) && rev!=form_rev && gmem[FORM_BASE+10+my_slot]==my_key ? (
        n=gmem[FORM_BASE+2]; n>=0 && n<=FORM_MAX ? (
            i=0; loop(n*3, mem[form_stage+i]=gmem[FORM_BASE+1024+i]; i+=1;);
            gmem[FORM_BASE+1]==rev && gmem[FORM_BASE+10+my_slot]==my_key ? (
                tmp=form_cache; form_cache=form_stage; form_stage=tmp; form_count=n; form_rev=rev; needs_tab_update=1;
            );
        );
    );
);
function resolve_pattern(t) local(out) (
    out=t<=0||mem[tab_mute_base+t] ? 0 : section_fallback(t);
    out>0 && mem[tab_mute_base+out] ? 0 : out;
); // Ensure this has its own space

function resolve_requested(t) local(out) (
    out=t<=0||mem[tab_mute_base+t]?0:get_active_fallback(t);
    out>0 && mem[tab_mute_base+out] ? 0 : out;
);

function factory_pattern(p,t) local(i,r,step,role,ptr) (
    memset(grid_base+t*vel_stride_tab,0,vel_stride_tab);
    memset(vel_base+t*vel_stride_tab,0,vel_stride_tab);
    memset(step_len_base+t*vel_stride_tab,0,vel_stride_tab);
    mem[bars_ov_base+t]=1; mem[subdiv_ov_base+t]=2;
    mem[half_speed_ov_base+t]=0; mem[tab_mute_base+t]=0;
    // Lane set 0 is rows 54..62; H/M/L are offsets 1/4/7.
    i=0; loop(16,
        step=i; r=-1;
        p==1 && step%2==0 ? r=step%6==0?61:step%6==2?58:55;
        p==2 && step%2==0 ? r=step%6==0?55:step%6==2?58:61;
        p==3 && step%2==0 ? r=step%8==0?61:step%8==4?55:58;
        p==4 && step%4==0 ? r=step%8==0?61:70;
        p==6 ? r=step%4==0?61:step%4==1?58:step%4==2?55:58;
        p==7 && (step==0||step==3||step==6||step==10||step==14) ? r=step%3==0?61:step%2==0?55:58;
        // Split presets use separate chord and LH bass lanes (LH octave zero).
        p==8 && step%4==0 ? r=step%8==0?97:94;
        p==9 && step%2==0 ? r=step%8==0?97:step%8==2?61:step%8==4?58:55;
        p==10 && (step==0||step==6||step==8||step==14) ? r=step==0||step==8?97:58;
        p==11 && step%4==0 ? r=61;
        p==12 && step%2==0 ? r=61;
        p==13 && (step==0||step==3||step==6||step==10||step==14) ? r=61;
        p==14 && step%2==0 ? r=step%4==0?61:52;
        r>=0 ? (ptr=t*vel_stride_tab+r*vel_stride_row+step; mem[grid_base+ptr]=1; mem[vel_base+ptr]=step%4==0?105:84;);
        (p==5 || p==8) && step%4==0 ? (
            role=0; loop(3,
                ptr=t*vel_stride_tab+(55+role*3)*vel_stride_row+step;
                mem[grid_base+ptr]=1; mem[vel_base+ptr]=95;
                role+=1;
            );
        );
        i+=1;
    );
    scan_active_tab();
);
function library_request(op,t,entry,revision) local(n,r,k,p,a) (
    gmem[6400000]==0 && abs(time_precise()-gmem[6400008])<3 ? (
        gmem[6400001]=slider5; gmem[6400002]=t;
        gmem[6400013]=slider14; gmem[6400014]=entry; gmem[6400015]=revision; gmem[6400011]=time_precise(); gmem[6400012]=my_key;
        gmem[6400003]=eff_bars(t); gmem[6400004]=eff_sub(t); gmem[6400005]=eff_hum(t); gmem[6400006]=eff_swing(t); gmem[6400007]=eff_half(t);
        n=0; r=0; loop(MAX_ROWS,
            k=0; loop(MAX_STEPS,
                p=t*vel_stride_tab+r*vel_stride_row+k;
                (op==1 || op==4) && mem[grid_base+p]>0 ? (
                    a=6400016+n*6; gmem[a]=r; gmem[a+1]=1; gmem[a+2]=k;
                    gmem[a+3]=mem[vel_base+p]; gmem[a+4]=mem[grid_base+p]; gmem[a+5]=mem[step_len_base+p]; n+=1;
                ); k+=1;
            ); r+=1;
        );
        gmem[6400009]=n; gmem[6400010]=mem[tab_mute_base+t]&2; gmem[6400000]=op;
    ) : gfx_showmenu("#Open Numbers2Notes first (or another request is pending)");
);


function show_pattern_library(t) local(base,rev,count,k,j,n,addr,builtins,first_file,sel,mode,p) (
    mode=slider14;
    strcpy(#lib_menu,"Save Pattern...|Load Pattern...|Export Factory Pattern...|Browse Factory Patterns...|Force Silence|Inherit (clear pattern)");
    mode==0 ? (
        strcat(#lib_menu,"|Ascending|Descending|Up and Down|Block Chords|Broken Chords|Syncopated"); builtins=6;
    ) : mode==1 ? (
        strcat(#lib_menu,"|Chords + Alternating Bass|Broken Chords + Bass|Syncopated Chords + Bass"); builtins=3;
    ) : (
        strcat(#lib_menu,"|Quarter Notes|Eighth Notes|Syncopated Bass|Octave Bass"); builtins=4;
    );
    base=6500000+mode*16384;
    rev=gmem[base]; count=0;
    abs(time_precise()-gmem[6400008])<3 && rev>0 && !(rev%2) ? (
        strcpy(#lib_base_menu,#lib_menu);
        count=min(100,max(0,floor(gmem[base+1])));
        k=0; loop(count,
            addr=base+2+k*100;
            strcat(#lib_menu,"|Factory: ");
            n=min(99,max(0,floor(gmem[addr])));
            j=1; loop(n,
                str_setchar(#lib_menu,strlen(#lib_menu),gmem[addr+j]);
                j+=1;
            );
            k+=1;
        );
        gmem[base]!=rev ? (strcpy(#lib_menu,#lib_base_menu); count=0;);
    );
    sel=gfx_showmenu(#lib_menu);
    sel==1 || sel==2 ? library_request(sel,t,0,0) :
    sel==3 ? library_request(4,t,0,0) :
    sel==4 ? library_request(7,t,0,0) :
    sel==5 || sel==6 ? (
        memset(grid_base+t*vel_stride_tab,0,vel_stride_tab);
        memset(vel_base+t*vel_stride_tab,0,vel_stride_tab);
        memset(step_len_base+t*vel_stride_tab,0,vel_stride_tab);
        mem[tab_mute_base+t]=sel==5?2:0;
        scan_active_tab(); needs_tab_update=1;
    ) :
    sel>=7 && sel<=6+builtins ? (
        p=sel-6;
        mode==0 ? (p>=4 ? p+=1;) : mode==1 ? (p+=7;) : (p+=10;);
        factory_pattern(p,t);
    ) :
    sel>6+builtins && sel<=6+builtins+count ? (
        library_request(6,t,sel-6-builtins,rev);
    );
);

@serialize
arp_loading=file_avail(0)>0;
file_mem(0, ui_base, 32);
file_mem(0, row_mute_base, MAX_ROWS); file_mem(0, row_solo_base, MAX_ROWS); 
file_mem(0, row_chan_base, MAX_ROWS); 
file_mem(0, row_level_base, MAX_ROWS); file_mem(0, row_human_base, MAX_ROWS); file_mem(0, row_len_base, MAX_ROWS); file_mem(0, row_color_base, MAX_ROWS);
file_mem(0, row_in_chan_base, MAX_ROWS); 
file_mem(0, bars_ov_base, MAX_TABS); file_mem(0, subdiv_ov_base, MAX_TABS); file_mem(0, hum_ov_base, MAX_TABS); file_mem(0, swing_ov_base, MAX_TABS);
file_mem(0, half_speed_ov_base, MAX_TABS); 
file_mem(0, vel_base, TOTAL_TABS * MAX_ROWS * MAX_STEPS); file_mem(0, grid_base, TOTAL_TABS * MAX_ROWS * MAX_STEPS); file_mem(0, step_len_base, TOTAL_TABS * MAX_ROWS * MAX_STEPS);
file_var(0, input_filter_mask);
file_var(0, global_out_mask);
arp_loading ? (
    file_avail(0)>0 ? (
    file_var(0,arp_ext_magic);
    arp_ext_magic==24632 ? (
        file_mem(0,tab_mute_base,TOTAL_TABS);
        file_var(0,form_count); form_count=max(0,min(FORM_MAX,floor(form_count)));
        form_count>0 ? file_mem(0,form_cache,form_count*3);
    );
    );
    form_rev=-1;
    scan_all_tabs();
) : (
        form_refresh(); arp_ext_magic=24632; file_var(0,arp_ext_magic);
        file_mem(0,tab_mute_base,TOTAL_TABS); file_var(0,form_count);
        form_count>0 ? file_mem(0,form_cache,form_count*3);
);




@block
// Accept deliberate host ID changes only when the destination slot is unowned.
// Keep the pattern data and local playback/lock state intact.
id_requested=max(1,min(512,floor(slider5+0.5)));
id_requested!=my_slot ? (
    (gmem[reg_base+id_requested]==0 || gmem[reg_base+id_requested]==my_key) ? (
        id_old=my_slot;
        gmem[reg_base+id_requested]=my_key;
        gmem[reg_base+id_old]==my_key ? gmem[reg_base+id_old]=0;
        my_slot=id_requested;
        slider5=my_slot;
        id_gm=7000000+(my_slot-1)*16;
        gmem[id_gm]=0x44504531;
        gmem[id_gm+1]=mem[ui_locked_tab];
        gmem[id_gm+2]=mem[ui_play_prog_tab];
        form_rev=-1;
        flush_inventory_to_gmem();
        needs_tab_update=1;
    ) : slider5=my_slot;
    sliderchange(slider5);
);
(gmem[6400000]==3 && gmem[6400001]==slider5 && gmem[6400012]==my_key) ? (
    lib_t=gmem[6400002]; lib_t>=1 && lib_t<TOTAL_TABS ? (
        memset(grid_base+lib_t*vel_stride_tab,0,vel_stride_tab); memset(vel_base+lib_t*vel_stride_tab,0,vel_stride_tab); memset(step_len_base+lib_t*vel_stride_tab,0,vel_stride_tab);
        mem[bars_ov_base+lib_t]=gmem[6400003]; lib_sub=gmem[6400004]; mem[subdiv_ov_base+lib_t]=lib_sub==8?0:lib_sub==12?1:lib_sub==16?2:lib_sub==24?3:4;
